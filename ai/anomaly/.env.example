# Copier en .env (même dossier). Valeurs par défaut = broker Docker local sans mot de passe.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
TOPIC_TELEMETRY=sentinel/esp8266/telemetry
TOPIC_ALERTS=sentinel/esp8266/alerts
CONSECUTIVE=3
# Quand le backend aura une route d'alertes :
# BACKEND_ALERT_URL=http://localhost:8000/api/alerts
